<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PdfSharp</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>GDI</DefineConstants>
    <PackageId>$(AssemblyName)</PackageId>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\..\StrongnameKey.snk</AssemblyOriginatorKeyFile>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--<Compile Include="..\..\..\shared\src\PdfSharp.System\System\CompilerServices.cs" Link="root\CompilerServices.cs" />-->
    <!--<Compile Include="..\..\..\shared\src\PdfSharp.System\System\CodeAnalysis.cs" Link="root\CodeAnalysis.cs" />-->
    <Compile Include="..\..\..\shared\src\PdfSharp.System\Properties\FloatOrDouble.cs" Link="Properties\FloatOrDouble.cs" />
    <!-- All source files of the PdfSharp project, except the ones excluded here. New files are included automatically. -->
    <Compile Include="..\PdfSharp\**\*.cs"
             Exclude="..\PdfSharp\bin\**;..\PdfSharp\obj\**;..\PdfSharp\Forms\**;..\PdfSharp\Windows\**;..\PdfSharp\Fonts\CoreBuildFontResolver.cs;..\PdfSharp\Fonts\WindowsPlatformFontResolver.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.Imaging\PdfSharp.Imaging.csproj" />
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.OpenType\PdfSharp.OpenType.csproj" />
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.Shared\PdfSharp.Shared.csproj" />
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.System\PdfSharp.System.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\PdfSharp\Resources\sRGB2014.icc" Link="Resources\sRGB2014.icc" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="PDFsharp.Tests-gdi,             PublicKey=$(PDFsharpStronNamePublicKey)" />
    <InternalsVisibleTo Include="PDFsharp.TestHelper-gdi,        PublicKey=$(PDFsharpStronNamePublicKey)" />
    <InternalsVisibleTo Include="PDFsharp.BarCodes-gdi,          PublicKey=$(PDFsharpStronNamePublicKey)" />
    <InternalsVisibleTo Include="PdfSharp.Annotations.Tests-gdi, PublicKey=$(PDFsharpStronNamePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>
