<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PdfSharp</RootNamespace>
    <UseWPF>true</UseWPF>
    <DefineConstants>WPF</DefineConstants>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\..\StrongnameKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\shared\src\PdfSharp.System\Properties\FloatOrDouble.cs" Link="Properties\FloatOrDouble.cs" />
    <!-- All source files of the PdfSharp project, except the ones excluded here. New files are included automatically. -->
    <Compile Include="..\PdfSharp\**\*.cs"
             Exclude="..\PdfSharp\bin\**;..\PdfSharp\obj\**;..\PdfSharp\Forms\**;..\PdfSharp\Fonts\CoreBuildFontResolver.cs;..\PdfSharp\Fonts\WindowsPlatformFontResolver.cs;..\PdfSharp\Windows\PagePreview-wpf.xaml.cs;..\PdfSharp\Windows\PagePreviewDesignTimeData.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.Imaging\PdfSharp.Imaging.csproj" />
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.OpenType\PdfSharp.OpenType.csproj" />
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.Shared\PdfSharp.Shared.csproj" />
    <ProjectReference Include="..\..\..\shared\src\PdfSharp.System\PdfSharp.System.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\PdfSharp\Resources\sRGB2014.icc" Link="Resources\sRGB2014.icc" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="PDFsharp.Tests-wpf,             PublicKey=$(PDFsharpStronNamePublicKey)" />
    <InternalsVisibleTo Include="PDFsharp.TestHelper-wpf,        PublicKey=$(PDFsharpStronNamePublicKey)" />
    <InternalsVisibleTo Include="PdfSharp.Annotations.Tests-wpf, PublicKey=$(PDFsharpStronNamePublicKey)" />
  </ItemGroup>

</Project>
