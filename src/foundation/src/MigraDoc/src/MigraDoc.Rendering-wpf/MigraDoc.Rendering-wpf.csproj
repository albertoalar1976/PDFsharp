<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MigraDoc</RootNamespace>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
    <UseWPF>true</UseWPF>
    <!--<DefineConstants>WPF</DefineConstants> technically not needed, but needs some work -->
    <!--<DefineConstants>WPF</DefineConstants>-->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\..\StrongnameKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--<Compile Include="..\..\..\..\..\foundation\src\shared\src\PdfSharp.System\System\CompilerServices.cs" Link="CompilerServices.cs" />-->
  </ItemGroup>

  <ItemGroup>
    <!-- All source files of the MigraDoc.Rendering project, except the ones excluded here. New files are included automatically. -->
