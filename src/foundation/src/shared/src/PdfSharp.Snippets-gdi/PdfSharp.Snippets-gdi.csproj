<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PdfSharp.Snippets</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>TRACE;GDI</DefineConstants>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\..\StrongnameKey.snk</AssemblyOriginatorKeyFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- All source files of the PdfSharp.Snippets project, except the ones excluded here. New files are included automatically. -->
    <Compile Include="..\PdfSharp.Snippets\**\*.cs"
             Exclude="..\PdfSharp.Snippets\bin\**;..\PdfSharp.Snippets\obj\**;..\PdfSharp.Snippets\Fonts.Text\**;..\PdfSharp.Snippets\Pangrams.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\..\..\assets\pdfsharp-6.x\fonts\SampleFonts\Oblivious.ttf" Link="assets\fonts\Oblivious.ttf" />
    <EmbeddedResource Include="..\..\..\..\..\..\assets\pdfsharp-6.x\fonts\SampleFonts\xfiles.ttf" Link="assets\fonts\xfiles.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!--<PackageReference Include="System.Security.Cryptography.Pkcs" />-->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfSharp.Shared\PdfSharp.Shared.csproj" />
    <ProjectReference Include="..\PdfSharp.System\PdfSharp.System.csproj" />
    <ProjectReference Include="..\..\..\PDFsharp\src\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\PdfSharp.Quality-gdi\PdfSharp.Quality-gdi.csproj" />
    <ProjectReference Include="..\PdfSharp.WPFonts\PdfSharp.WPFonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="assets\fonts\" />
    <Folder Include="assets\images\" />
    <Folder Include="assets\PDFs\" />
  </ItemGroup>

  <!--<ItemGroup>
    <None Include="..\PdfSharp.Snippets\assets\fonts\LICENSE.md" Link="assets\fonts\LICENSE.md" />
  </ItemGroup>-->

</Project>
